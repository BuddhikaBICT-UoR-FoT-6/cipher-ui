# Backend environment variables (copy to .env and fill values)

APP_NAME=Cipher Project
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cipher_db

# Railway MySQL automatic variables (used if above are not provided)
# MYSQLHOST=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQLPORT=

# Azure Database for MySQL (Flexible Server) typically requires TLS.
# Set DB_SSL=true when connecting to Azure.
DB_SSL=false
# If your platform uses a trusted CA, leave this as true.
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change_me_in_production

# Used to encrypt secrets stored in the DB (e.g., SMTP password in system_email_settings).
# Provide a long random value in production.
EMAIL_SETTINGS_ENC_KEY=change_me_in_production

# Email (SMTP)
# For Gmail, you must use an App Password (requires 2-Step Verification).
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=edwarddawnguard@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=edwarddawnguard@gmail.com

# Local dev fallback (no SMTP): print OTPs to backend console.
DEV_PRINT_OTPS=false

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
FAILED_LOGIN_EMAIL_COOLDOWN_SECONDS=300
